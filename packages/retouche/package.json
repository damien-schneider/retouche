{
  "name": "retouche-dev",
  "version": "0.1.2",
  "description": "Dots on every element whose call site overrides your design system's typography.",
  "keywords": [
    "bun",
    "design-system",
    "devtools",
    "nextjs",
    "overlay",
    "react",
    "typography",
    "vite"
  ],
  "homepage": "https://retouche.dev",
  "bugs": "https://github.com/damien-schneider/retouche/issues",
  "license": "MIT",
  "author": "Damien Schneider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damien-schneider/retouche.git",
    "directory": "packages/retouche"
  },
  "bin": {
    "retouche": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "PROMPT.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./hand-arrow": {
      "types": "./dist/hand-arrow.d.ts",
      "default": "./dist/hand-arrow.js"
    },
    "./instrument": {
      "types": "./dist/instrument.d.ts",
      "default": "./dist/instrument.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack": "tsdown && bun pm pack --filename retouche.tgz --quiet",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@zumer/snapdom": "^3.8.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "bippy": "^0.7.3",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sugar-high": "^2.7.0",
    "tsdown": "^0.23.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9"
  }
}
